  },
  "author": "Ksenia Lebedeva",
  "dependencies": {
    "@choppu/shelljs": "^2.0.0",
    "node-hid": "^3.4.0",
    "usb": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/w3c-web-usb": "^1.0.14",
    "typescript": "^6.0.3"
