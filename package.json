{
  "name": "@choppu/shelljs-node-hid",
  "version": "2.0.0",
  "description": "Keycard Shell Node implementation of the communication layer",
  "main": "lib/index.js",
  "module": "lib-es/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "url": "https://github.com/choppu/shelljs-node-hid.git"
  },
  "license": "Apache-2.0",
  "scripts": {
